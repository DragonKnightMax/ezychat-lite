{
  "name": "@ezychat/web",
  "version": "0.1.66",
  "type": "module",
  "description": "EzyChat core: the team inbox web app (React) as a library, with createInboxApp and its extension API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossmalaysia/ezychat-lite.git",
    "directory": "apps/web"
  },
  "homepage": "https://ezychat.ai/",
  "exports": {
    ".": {
      "ezychat-source": "./src/index.ts",
      "types": "./dist-lib/types/index.d.ts",
      "default": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/ezychat-web.css",
    "./sw.ts": "./dist-lib/sw.ts",
    "./public/*": {
      "ezychat-source": "./public/*",
      "default": "./dist-lib/public/*"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist-lib/types/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/precompress-web.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build:lib": "node ../../scripts/build-web-lib.mjs"
  },
  "dependencies": {
    "@ezychat/shared": "0.1.66",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "nspell": "2.1.5",
    "opus-recorder": "8.0.5",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/nspell": "2.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "dictionary-en-gb": "3.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
